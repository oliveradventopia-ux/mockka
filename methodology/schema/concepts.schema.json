{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mockka.dev/schema/concepts.schema.json",
  "title": "Mockka concept inventory (content/<slug>/concepts.json)",
  "description": "Master concept inventory. Every concept must be the primary concept of exactly one bank item, and its sources[] must reference source ids registered in manifest.json provenance — that join is the provenance chain the validator enforces (question -> concept -> derivation doc -> registered source).",
  "type": "object",
  "required": ["concepts"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "version": { "type": "string" },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "domain", "statement", "vocabulary", "priority", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "pattern": "^d[0-9]+$" },
          "statement": { "type": "string", "minLength": 21 },
          "vocabulary": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "priority": { "enum": ["high", "normal"] },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["artefact"],
              "additionalProperties": false,
              "properties": {
                "artefact": {
                  "type": "string",
                  "description": "A registered source id from manifest.json provenance.sources[]."
                },
                "items": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Item references inside that source's derivation doc, when applicable."
                }
              }
            }
          },
          "syllabus_rule": {
            "type": "string",
            "description": "Resolved against syllabus-rules.json when manifest layers.syllabus_rules is true."
          }
        }
      }
    }
  }
}
