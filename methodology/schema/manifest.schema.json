{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mockka.dev/schema/manifest.schema.json",
  "title": "Mockka exam manifest (content/<slug>/manifest.json)",
  "description": "Exam identity plus the ENTIRE blueprint as data. Everything the original CCAR-P validator hardcoded lives here; the validator (packages/engine/src/validate/) reads it and enforces the invariants.",
  "type": "object",
  "required": [
    "slug", "title", "vendor", "status", "version",
    "exam", "bank", "domains", "formats", "style", "validation", "layers", "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "vendor": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "in_review", "published"] },
    "version": { "type": "string", "minLength": 1 },
    "blueprint_version": { "type": "string" },
    "source_checked_date": { "type": "string", "format": "date" },
    "exam": {
      "type": "object",
      "required": ["item_count", "time_limit_minutes", "pass_threshold_pct"],
      "additionalProperties": false,
      "properties": {
        "item_count": { "type": "integer", "minimum": 1 },
        "time_limit_minutes": { "type": "integer", "minimum": 1 },
        "pass_threshold_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "bank": {
      "type": "object",
      "required": ["item_count"],
      "additionalProperties": false,
      "properties": { "item_count": { "type": "integer", "minimum": 1 } }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "weight_pct", "exam_items", "bank_items", "format_mix"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^d[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "weight_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "exam_items": { "type": "integer", "minimum": 0 },
          "bank_items": { "type": "integer", "minimum": 0 },
          "format_mix": {
            "type": "object",
            "required": ["single_choice", "multiple_response", "scenario_matching"],
            "additionalProperties": false,
            "properties": {
              "single_choice": { "type": "integer", "minimum": 0 },
              "multiple_response": { "type": "integer", "minimum": 0 },
              "scenario_matching": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "formats": {
      "type": "object",
      "required": ["single_choice", "multiple_response", "scenario_matching"],
      "additionalProperties": false,
      "properties": {
        "single_choice": {
          "type": "object",
          "required": ["options"],
          "additionalProperties": false,
          "properties": { "options": { "type": "integer", "minimum": 2 } }
        },
        "multiple_response": {
          "type": "object",
          "required": ["options", "select_count"],
          "additionalProperties": false,
          "properties": {
            "options": { "type": "integer", "minimum": 3 },
            "select_count": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 2 }
            }
          }
        },
        "scenario_matching": {
          "type": "object",
          "required": ["min_options", "min_scenarios", "require_option_reuse"],
          "additionalProperties": false,
          "properties": {
            "min_options": { "type": "integer", "minimum": 2 },
            "min_scenarios": { "type": "integer", "minimum": 2 },
            "require_option_reuse": { "type": "boolean" }
          }
        }
      }
    },
    "style": {
      "type": "object",
      "required": ["locale", "emoji"],
      "additionalProperties": false,
      "properties": {
        "locale": { "type": "string", "minLength": 2 },
        "emoji": { "type": "boolean" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["pattern_caps", "near_duplicate_jaccard"],
      "additionalProperties": false,
      "properties": {
        "pattern_caps": {
          "type": "object",
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        },
        "near_duplicate_jaccard": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "key_letter_max_share": {
          "$comment": "BD-1 knob (key-position-distribution): max share of single_choice items any one key letter may carry. Default 0.4; bounds mirror the validator's.",
          "type": "number", "minimum": 0.25, "maximum": 0.6
        },
        "mr_key_set_max_share": {
          "$comment": "BD-1 knob: max share of multiple_response items sharing one exact key set. Default 0.5.",
          "type": "number", "minimum": 0.25, "maximum": 0.75
        },
        "answer_length_ratio_warn": {
          "$comment": "BD-2 knob (answer-length-cue): warn-tier keyed-option/longest-distractor length ratio. Default 1.25; must not exceed the error tier.",
          "type": "number", "minimum": 1.05, "maximum": 1.5
        },
        "answer_length_ratio_error": {
          "$comment": "BD-2 knob: error-tier length ratio. Default 1.5.",
          "type": "number", "minimum": 1.2, "maximum": 2
        },
        "key_length_rank_warn_share": {
          "$comment": "E1 knob (key-length-rank-share): warn-tier max share of SC items whose key is the strict longest/shortest option. Default 0.35; bounds mirror the validator's.",
          "type": "number", "minimum": 0.25, "maximum": 0.45
        },
        "key_length_rank_error_share": {
          "$comment": "E1 knob: error-tier rank share. Default 0.45.",
          "type": "number", "minimum": 0.35, "maximum": 0.55
        },
        "rider_balance_min_share": {
          "$comment": "E2 knob (rider-balance): floor of the key share among rider-carrying options (chance 0.25). Default 0.10.",
          "type": "number", "minimum": 0.02, "maximum": 0.2
        },
        "rider_balance_max_share": {
          "$comment": "E2 knob: ceiling of the key share among rider-carrying options. Default 0.45.",
          "type": "number", "minimum": 0.3, "maximum": 0.6
        },
        "named_entity_parity_warn_share": {
          "$comment": "E3 knob (named-entity-parity): warn-tier max share of qualifying items whose single most-entity-naming option is the key. Default 0.40.",
          "type": "number", "minimum": 0.3, "maximum": 0.55
        },
        "named_entity_parity_error_share": {
          "$comment": "E3 knob: error-tier share. Default 0.55.",
          "type": "number", "minimum": 0.4, "maximum": 0.7
        },
        "option_pair_jaccard_warn": {
          "$comment": "E6 knob (option-pair-similarity): warn-tier intra-item option-pair shingle jaccard. Default 0.6.",
          "type": "number", "minimum": 0.4, "maximum": 0.75
        },
        "option_pair_jaccard_error": {
          "$comment": "E6 knob: error-tier jaccard. Default 0.75.",
          "type": "number", "minimum": 0.6, "maximum": 0.9
        }
      }
    },
    "layers": {
      "type": "object",
      "required": ["syllabus_rules"],
      "additionalProperties": false,
      "properties": { "syllabus_rules": { "type": "boolean" } }
    },
    "intro": {
      "description": "Introduction page block, rendered by the player intro tab and the standalone export. Presence ratchet (methodology/06-provenance-publishing.md#intro): optional for draft; the validator's intro-presence check warns when missing on in_review; publication-preflight errors when missing on published. Shape when present is enforced by intro-presence.",
      "type": "object",
      "required": ["about", "audience", "materials", "official_resources", "disclaimer"],
      "additionalProperties": false,
      "properties": {
        "about": {
          "type": "string", "minLength": 1,
          "description": "Executive summary: what the certification validates, domains covered."
        },
        "audience": {
          "type": "string", "minLength": 1,
          "description": "Who the certification is for (roles)."
        },
        "materials": {
          "description": "What THIS mock provides (bank size, formats, dashboard, review depth).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "description"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "official_resources": {
          "description": "Official cert portal / guide links; rendered as external links (https only).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "pattern": "^https://" }
            }
          }
        },
        "disclaimer": {
          "type": "string", "minLength": 1,
          "description": "Attribution / independence / personal-use notice: independent study tool, unaffiliated with the vendor, provenance statement, NDA reminder — exam-specific wording, aligned with the package README (cite, don't contradict)."
        }
      }
    },
    "format_coverage": {
      "type": "string",
      "description": "Disclosure shown on the exam intro page when the real exam's format profile exceeds the three supported formats (plan Decision 7)."
    },
    "provenance": {
      "type": "object",
      "required": ["sources", "nda_statement"],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type", "citation"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "type": {
                "enum": [
                  "public_blueprint", "public_syllabus", "public_practice_set",
                  "own_course_notes", "own_distillation", "licensed_import"
                ]
              },
              "citation": { "type": "string", "minLength": 1 },
              "license": {
                "type": "string",
                "description": "Required for licensed_import. Allowlist enforced by the validator: CC-BY-4.0, MIT, Apache-2.0, author-agreement."
              },
              "attribution": { "type": "string" }
            }
          }
        },
        "nda_statement": { "type": "string", "minLength": 1 }
      }
    }
  }
}
