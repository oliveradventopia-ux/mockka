{
  "name": "mockka",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --filter @mockka/web dev",
    "build": "pnpm --filter @mockka/web build",
    "validate": "node packages/engine/src/validate/cli.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test \"packages/engine/test/**/*.test.ts\" \"apps/web/test/**/*.test.ts\"",
    "gate": "pnpm validate && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=24"
  }
}
